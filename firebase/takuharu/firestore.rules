rules_version = '2';

// たくはるファイナンス Firestore Security Rules
//
// 設計方針:
//   - 許可された uid（allowedUsers）のみ全データにアクセス可能
//     （= 指定の2人＋検証用 だけが使える）
//   - データ共有は households の members（世帯コードで参加）で行う
//   - users/{uid} … 本人のみ / households/** … メンバーのみ
//   - その他は全拒否（デフォルト deny）
//
// アカウントを追加/削除したい場合は allowedUsers の uid を編集すること。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 許可された uid 一覧（この人たちだけアクセス可能）
    function allowedUsers() {
      return [
        'yfTtT5N1DTNPgtm7PXM2l1mTkY92',  // fffuttta@gmail.com
        'TdIx6DB8PpVdPH7wo3QhavmP1ia2',  // noel.31128@gmail.com
        'vnoNjaHvhvew2HYhfSY7DlqLyC72'   // takuharumika@gmail.com (検証用)
      ];
    }

    function isAllowed() {
      return isSignedIn() && request.auth.uid in allowedUsers();
    }

    // はるファイナンスを使えるアカウント（メールで判定＝uid のズレに強い）。
    function isHaruAccount() {
      return isSignedIn() && request.auth.token.email in [
        'noel.31128@gmail.com',
        'takuharumika@gmail.com'
      ];
    }

    // 自分のユーザードキュメント。
    //  - ドキュメント本体: たくはる用（従来どおり allowedUsers 限定）。
    //  - 配下すべて: はるファイナンス旧版(v1.0.2)互換。noel/takuharumika が
    //    自分の users/{uid}/… にアクセスできる（他人は不可）。
    match /users/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if isHaruAccount() && request.auth.uid == uid;
      }
    }

    // はるファイナンス専用データ（v1.0.3〜）。noel と takuharumika の 2 人だけ。
    match /haru/{uid} {
      allow read, write: if isHaruAccount() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if isHaruAccount() && request.auth.uid == uid;
      }
    }

    // 世帯ドキュメント
    match /households/{hid} {
      function isMember() {
        return isSignedIn()
            && resource.data.members is list
            && request.auth.uid in resource.data.members;
      }
      allow create: if isAllowed()
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members;
      // join 時の存在確認のため、許可ユーザーなら get は許可。
      allow get: if isAllowed();
      allow list: if isAllowed() && isMember();
      allow update: if isAllowed()
          && (isMember()
              || request.auth.uid in request.resource.data.members);
      allow delete: if isAllowed() && isMember();

      // 世帯配下の取引
      match /transactions/{txId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }
        allow read, write: if isAllowed()
            && request.auth.uid in parentMembers();

        // 取引ごとのチャット（たく＆はるの会話）
        match /comments/{commentId} {
          function members2() {
            return get(/databases/$(database)/documents/households/$(hid)).data.members;
          }
          allow read, write: if isAllowed()
              && request.auth.uid in members2();
        }
      }

      // 世帯配下のレシート（同じ receiptId の品目をまとめた単位）とそのチャット。
      // レシート単位のコメントを1本にまとめて持たせる（品目とは独立）。
      match /receipts/{receiptId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }
        allow read, write: if isAllowed()
            && request.auth.uid in parentMembers();

        // レシートごとのチャット（たく＆はるの会話）
        match /comments/{commentId} {
          function members2() {
            return get(/databases/$(database)/documents/households/$(hid)).data.members;
          }
          allow read, write: if isAllowed()
              && request.auth.uid in members2();
        }
      }

      // 世帯配下のプランニング項目（やりたいこと/行きたい場所/お店）
      match /plan_items/{itemId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }
        allow read, write: if isAllowed()
            && request.auth.uid in parentMembers();

        // プランニング項目ごとのチャット（たく＆はるの会話）
        match /comments/{commentId} {
          function members2() {
            return get(/databases/$(database)/documents/households/$(hid)).data.members;
          }
          allow read, write: if isAllowed()
              && request.auth.uid in members2();
        }
      }

      // 世帯配下の固定費・サブスク
      match /subscriptions/{subId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }
        allow read, write: if isAllowed()
            && request.auth.uid in parentMembers();
      }

      // 世帯配下の特別支出（旅行・引っ越しなど、支出を束ねる箱）
      match /special_expenses/{seId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }
        allow read, write: if isAllowed()
            && request.auth.uid in parentMembers();
      }

      // 世帯配下の口座・クレカ（残高管理）
      match /accounts/{accountId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }
        allow read, write: if isAllowed()
            && request.auth.uid in parentMembers();
      }
    }
  }
}
